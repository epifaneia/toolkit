# Copia este fichero a .env y rellena lo que uses. El .env nunca se sube al repo.
# Sin rellenar nada, el esqueleto corre con MOTOR=stub: sin red y sin claves.

# --- Paso 4: qué modelo usa el esqueleto ---
# stub | ollama | gemini | deep_research | jev | whisper | kokoro
MOTOR=stub

# --- Ollama (local: nada sale de la máquina) ---
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=qwen2.5:7b
# num_ctx: no bajarlo a ciegas. Ollama recorta el prompt en silencio.
# OLLAMA_NUM_CTX=16384

# --- Gemini (nube: el dato sale y el ledger lo registra) ---
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# --- Deep research (nube, usa GEMINI_API_KEY y el SDK google-genai) ---
# DEEP_RESEARCH_AGENT=deep-research-preview-04-2026
# RESEARCH_TIMEOUT_S=2700

# --- Jev vía OpenRouter (nube, de pago) ---
OPENROUTER_API_KEY=
# JEV_MODEL=typesafe/jev-1.14
# Tope de gasto acumulado en dólares, sumado desde el ledger
# JEV_TOPE_USD=0.25

# --- Voz (local) ---
# WHISPER_MODEL=large-v3-turbo
# WHISPER_DEVICE=cpu
# WHISPER_COMPUTE=int8
# KOKORO_VOZ=ef_dora
# KOKORO_IDIOMA=e

# --- Custodia: los tres cables de integración (docs/INTEGRATION.md) ---
# CUSTODIA_ACTOR: obligatorio, sin actor no corre nada (p. ej. ana.garcia)
CUSTODIA_ACTOR=
# CUSTODIA_LEDGER: una línea JSON por llamada a un modelo (o - para stdout)
CUSTODIA_LEDGER=logs/custody.jsonl
# CUSTODIA_SIGNING_KEY: clave local de firma; la empresa la sustituye por su PKI
CUSTODIA_SIGNING_KEY=
